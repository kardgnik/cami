# Conexão com o PostgreSQL (o docker-compose.yml sobe um banco com estes dados)
DATABASE_URL="postgresql://cami:cami@localhost:5432/cami?schema=public"

# Segredo para assinar o cookie de sessão. Gere um com: openssl rand -base64 32
SESSION_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Login do gerente criado/atualizado por `npm run db:seed`
# (usuário: 3 a 40 letras minúsculas, números, ponto, hífen ou sublinhado)
ADMIN_USUARIO="admin"
ADMIN_PASSWORD="troque-esta-senha"

# Cookie de sessão só em HTTPS. Padrão: ligado em produção.
# Em instalação local acessada por outros aparelhos da rede via http://, use "false".
# COOKIE_SECURE="false"

# Domínio público usado através de um túnel/proxy (ex.: Cloudflare Tunnel), separado por vírgula.
# Só é necessário se os formulários falharem pelo domínio. Depois de alterar, gere o build de novo.
# DOMINIO_PUBLICO="mdl.luisk.com.br"
