// Valores monetários são armazenados em centavos (Int) e percentuais em
// pontos-base (Int, 1% = 100) para evitar erros de arredondamento de ponto flutuante.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Periodicidade {
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

/// Como a sessão foi realizada. Define o valor pago ao mestre.
enum TipoSessao {
  NORMAL      // sessão comum da mesa: 1× o valor da mesa
  REPOSICAO   // repõe uma sessão que não aconteceu: 1× o valor da mesa
  EXTRA       // sessão a mais da mesa: 1× o valor da mesa
  DUPLA       // sessão dupla da mesa: 2× o valor da mesa
  ONESHOT     // oneshot paga, sem mesa fixa: valor configurado em Configuracao
  MENSALIDADE // não é uma sessão: lançamento mensal de mesa paga por aluno (alunos × valor por aluno)
}

/// Como o mestre é pago nas mesas de um tipo.
enum PagamentoMestre {
  POR_SESSAO // valor por sessão conduzida
  POR_ALUNO  // valor por aluno, por mês (lançado como MENSALIDADE)
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

enum StatusAssinatura {
  ATIVO
  INADIMPLENTE
  CANCELADO
}

/// Administrador do sistema. Entra com nome de usuário e senha.
model Gerente {
  id        Int      @id @default(autoincrement())
  usuario   String   @unique
  senhaHash String
  createdAt DateTime @default(now())

  @@map("gerentes")
}

model Plataforma {
  id               Int          @id @default(autoincrement())
  nome             String       @unique
  taxaPercentualBp Int          @default(0)
  taxaFixaCentavos Int          @default(0)
  ativo            Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  assinaturas      Assinatura[]

  @@map("plataformas")
}

model MetodoPagamento {
  id               Int          @id @default(autoincrement())
  nome             String       @unique
  taxaPercentualBp Int          @default(0)
  taxaFixaCentavos Int          @default(0)
  ativo            Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  assinaturas      Assinatura[]

  @@map("metodos_pagamento")
}

model Plano {
  id            Int           @id @default(autoincrement())
  nome          String        @unique
  descricao     String?
  valorCentavos Int
  periodicidade Periodicidade @default(MENSAL)
  /// Quantas mesas uma assinatura deste plano pode incluir.
  limiteMesas   Int           @default(1)
  /// Grupo fechado: a mesa vinculada fica sem vagas para jogadores de outros planos.
  grupoFechado  Boolean       @default(false)
  ativo         Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  assinaturas   Assinatura[]

  @@map("planos")
}

/// A pessoa que joga. Pode ter várias assinaturas.
model Jogador {
  id          Int          @id @default(autoincrement())
  nome        String
  telefone    String
  email       String?
  observacoes String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assinaturas Assinatura[]

  @@index([nome])
  @@map("jogadores")
}

/// O que o jogador paga: plano + plataforma de origem + método de pagamento.
/// Cobre até `plano.limiteMesas` mesas.
model Assinatura {
  id                Int              @id @default(autoincrement())
  jogadorId         Int
  planoId           Int
  plataformaId      Int
  metodoPagamentoId Int
  status            StatusAssinatura @default(ATIVO)
  dataInicio        DateTime         @db.Date
  /// Promoção: valor cobrado no lugar do valor do plano até `promocaoAte` (inclusive).
  /// Depois dessa data a assinatura volta sozinha ao valor do plano.
  valorPromocionalCentavos Int?
  promocaoAte              DateTime? @db.Date
  observacoes       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  jogador         Jogador         @relation(fields: [jogadorId], references: [id], onDelete: Cascade)
  plano           Plano           @relation(fields: [planoId], references: [id], onDelete: Restrict)
  plataforma      Plataforma      @relation(fields: [plataformaId], references: [id], onDelete: Restrict)
  metodoPagamento MetodoPagamento @relation(fields: [metodoPagamentoId], references: [id], onDelete: Restrict)
  mesas           AssinaturaMesa[]

  @@index([jogadorId])
  @@index([status])
  @@index([planoId])
  @@index([plataformaId])
  @@index([metodoPagamentoId])
  @@map("assinaturas")
}

/// Vínculo de uma assinatura (e portanto de um jogador) com uma mesa.
model AssinaturaMesa {
  assinaturaId Int
  mesaId       Int
  createdAt    DateTime @default(now())

  assinatura Assinatura @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)
  mesa       Mesa       @relation(fields: [mesaId], references: [id], onDelete: Restrict)

  @@id([assinaturaId, mesaId])
  @@index([mesaId])
  @@map("assinaturas_mesas")
}

/// VIP, Especial... Define o valor padrão pago ao mestre por sessão.
model TipoMesa {
  id                  Int      @id @default(autoincrement())
  nome                String          @unique
  /// Valor por sessão (tipos pagos por sessão).
  valorSessaoCentavos Int
  pagamentoMestre     PagamentoMestre @default(POR_SESSAO)
  /// Valor por aluno, por mês (tipos pagos por aluno).
  valorAlunoCentavos  Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  mesas               Mesa[]

  @@map("tipos_mesa")
}

/// Quem conduz as mesas. Acessa o painel do mestre com nome de usuário e senha.
model Mestre {
  id        Int      @id @default(autoincrement())
  nome      String
  usuario   String   @unique
  email     String?
  senhaHash String
  telefone  String?
  chavePix  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mesas     Mesa[]
  sessoes   Sessao[]

  @@map("mestres")
}

model Mesa {
  id                  Int              @id @default(autoincrement())
  nome                String           @unique
  descricao           String?
  tipoMesaId          Int
  mestreId            Int?
  /// Se preenchido, substitui o valor por sessão do tipo da mesa.
  valorSessaoCentavos Int?
  /// Se preenchido, substitui o valor por aluno/mês do tipo da mesa (tipos pagos por aluno).
  valorAlunoCentavos  Int?
  /// Dia da semana em que a mesa joga.
  diaSemana           DiaSemana?
  /// Sessões previstas por mês (usado na previsão de custo com mestres).
  sessoesPorMes       Int              @default(2)
  capacidade          Int              @default(6)
  ativo               Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  tipoMesa    TipoMesa         @relation(fields: [tipoMesaId], references: [id], onDelete: Restrict)
  mestre      Mestre?          @relation(fields: [mestreId], references: [id], onDelete: SetNull)
  assinaturas AssinaturaMesa[]
  sessoes     Sessao[]

  @@index([mestreId])
  @@index([tipoMesaId])
  @@map("mesas")
}

/// Um lançamento a pagar ao mestre: uma sessão conduzida ou, nas mesas pagas por
/// aluno, a mensalidade do mês. O valor é gravado no registro para que mudanças
/// de preço posteriores não alterem o histórico.
model Sessao {
  id             Int        @id @default(autoincrement())
  tipo           TipoSessao @default(NORMAL)
  /// Vazio só em oneshots.
  mesaId         Int?
  /// Nome da oneshot (só quando tipo = ONESHOT).
  nomeOneshot    String?
  mestreId       Int
  /// Data em que a sessão aconteceu (é a que conta para o mês do pagamento).
  data           DateTime   @db.Date
  /// Reposição: data da sessão original que está sendo reposta.
  dataReferencia DateTime?  @db.Date
  valorCentavos  Int
  /// Mensalidade: quantos alunos entraram no cálculo.
  alunos         Int?
  observacoes   String?
  /// Preenchido quando o gerente marca a sessão como paga.
  pagoEm        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  mesa   Mesa?  @relation(fields: [mesaId], references: [id], onDelete: Restrict)
  mestre Mestre @relation(fields: [mestreId], references: [id], onDelete: Restrict)

  // o tipo entra na chave para a mensalidade (datada no dia 1º) conviver com uma sessão nesse dia;
  // sessões de tipos diferentes na mesma mesa e data são barradas em lib/sessoes.ts
  @@unique([mesaId, data, tipo])
  @@index([mestreId, pagoEm])
  @@index([data])
  @@map("sessoes")
}

/// Configurações gerais (uma única linha, id = 1).
model Configuracao {
  id                   Int      @id @default(1)
  /// Valor pago ao mestre por uma oneshot paga.
  valorOneshotCentavos Int      @default(3500)
  updatedAt            DateTime @updatedAt

  @@map("configuracoes")
}
